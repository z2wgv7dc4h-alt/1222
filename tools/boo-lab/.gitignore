# `pip install -e .` build metadata -- regenerated on every install.
*.egg-info/

# Machine/derived outputs: regenerable from the human keeper pins plus the
# optional interns (`structure`/`beats`/`compare`/`sync`/`agree`). The tracked
# asset is data/sections.jsonl (human pins); these are its echoes.
data/drafts.jsonl
data/beats.jsonl
data/compare.json
data/sync.jsonl
data/agree.jsonl
# Save's one-step-undo backup of the tracked keeper file, plus any transient
# file left by the atomic writer (schema.write_jsonl_atomic).
data/sections.jsonl.bak
data/*.tmp
*.flac
*.wav
*.gp3
*.gp4
*.gp5
*.gpx
*.gp*
*.gp
*.zip
# The bundled fixtures are hand-made for tests, not real tabs/packs.
!tests/fixtures/tiny.gp
!tests/fixtures/tabnotes_tiny.zip

# Real extracted note/pitch/onset content -- same local-only posture as
# engine/data/riff_bank.json (too close to source songs melodic content
# for a public repo).
data/riffs.jsonl
data/vocal_melody.jsonl
data/drum_patterns.jsonl
data/section_tempo.jsonl
data/figures.jsonl
data/gp_export.jsonl
# Learn spine: the event log and the derived intern rank are local only
# (ranked from a tiny keeper set; not a committed artifact).
data/learn.jsonl
data/intern_rank.json
# Operator-provided tab-notes packs (may be commercial tabs: never commit).
data/tabnotes/
data/tabnotes_index.jsonl
# Per-album calibration blob (generated from the first heard pairs).
data/adapt.json

# Private corpus map (absolute FLAC/GP paths + hashes). Regenerated by scan+hash.
data/map.csv
# Machine-leaking / regenerable dumps: absolute FLAC paths (flacs.csv,
# corpus_health.json) and the duplicate-line learn event log. Never labeled
# assets -- the tracked label files are sections.jsonl / holdout.csv / CATALOG.md.
data/flacs.csv
data/corpus_health.json
data/learn-log.jsonl

