{
  "permissions": {
    "deny": [
      "Read(../Ww/**)",
      "Edit(../Ww/**)",
      "Write(../Ww/**)",
      "Read(../123/**)",
      "Edit(../123/**)",
      "Write(../123/**)",
      "Read(docs/archive/**)",
      "Edit(docs/archive/**)",
      "Write(docs/archive/**)",
      "Read(engine/riff_model.py)",
      "Edit(engine/riff_model.py)",
      "Write(engine/riff_model.py)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.ps1\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-write.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-tool.ps1\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-compact.ps1\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-handoff.ps1\""
          },
          {
            "type": "prompt",
            "prompt": "Stop. Do not append PROGRESS.md. Do not read docs/archive. Do not import riff_model.py. Do not start the next task. Do not push unless the user asked. Then {\"decision\":\"stop\"}."
          }
        ]
      }
    ]
  }
}
